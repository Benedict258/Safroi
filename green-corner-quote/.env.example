# Postgres connection string (Neon, Supabase, or local)
DATABASE_URL=postgres://postgres@localhost:5432/gcq

# Session signing secret: at least 32 random characters
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The one admin account. Generate the hash with: npm run hash-password -- 'your password'
ADMIN_EMAIL=benedict@example.com
ADMIN_PASSWORD_HASH=

# Contact shown in the scraper User-Agent so Hub360 can reach the Waste2Light team
SYNC_CONTACT=https://waste2light.com
