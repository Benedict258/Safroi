# Required: Google AI Studio API key (auth key type, not legacy standard key)
# Get one at https://aistudio.google.com/apikey
# Can also use GOOGLE_API_KEY — the SDK auto-detects both
GEMINI_API_KEY=

# Optional: Gemma model override (default: gemma-4-26b-a4b-it)
GEMINI_MODEL=gemma-4-26b-a4b-it

# Optional: Serper.dev API key for Google Search fallback
SERPER_API_KEY=

# Server port
PORT=3000

# Application URL
APP_URL=http://localhost:3000
VITE_BASE=/
DISABLE_HMR=false

# MongoDB connection
# For Docker: mongodb://mongodb:27017/safroi
# For local:  mongodb://localhost:27017/safroi
MONGODB_URI=mongodb://localhost:27017/safroi

# JWT secret (auto-generated if not set)
JWT_SECRET=

# Email (SMTP) — for password reset emails
# Optional: if not set, reset links are logged to console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Safroi <noreply@safroi.com>
