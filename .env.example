# NVIDIA NIM (primary AI). Model ids are overridable; verify with GET https://integrate.api.nvidia.com/v1/models
NIM_ANALYSIS_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_FALLBACK_MODEL=google/gemma-4-31b-it
NIM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NIM_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# N-ATLaS translation server (see deploy/natlas_colab.ipynb); leave empty to use NIM for translation
NATLAS_BASE_URL=
NATLAS_API_KEY=
NATLAS_MODEL=NCAIR1/N-ATLaS
NATLAS_TIMEOUT_MS=120000
# Scan quotas (Pro/Business are unlimited)
FREE_SCANS_PER_MONTH=10
ANON_SCANS_PER_DAY=3
# N-ATLaS circuit breaker: how long to skip a failed server
NATLAS_COOLDOWN_MS=60000
